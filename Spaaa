	base_name_patterns = { "base", "pen", "hatch", "deposit", "dropoff" },
	steal_action_keys  = { "steal", "roubar", "take", "grab" },
	drop_action_keys   = { "drop", "soltar", "place", "deposit", "throw" },

	carry_speed     = 65,
	default_speed   = 16,
	auto_return_interval = 0.5,
	auto_grab_interval   = 0.12,

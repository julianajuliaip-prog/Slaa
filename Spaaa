local function show_tab(name)
	for n, f in pairs(TABS) do f.Visible = (n == name) end
	active_tab = name
	for _, other in ipairs(tabbar:GetChildren()) do
		if other:IsA("TextButton") then
			local on = other.Text == name
			other.BackgroundColor3 = on and Color3.fromRGB(30, 45, 35)

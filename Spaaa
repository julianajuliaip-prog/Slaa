-- ================= HELPERS =================
local ui = {}

local function has_any(s, list)
	s = string.lower(tostring(s or ""))
	for _, p in ipairs(list) do
		if string.find(s, p, 1, true) then return true end
	end
	return false
end

local function get_hum()
	local c = player.Character
	return c and c:FindFirstChildOfClass("Humanoid")
end

local function get_root()
	local c = player.Character
	return c and c:FindFirstChild("HumanoidRootPart")
end

local function scan_parts(patterns, only_prompt)
	local out, seen = {}, {}
	local function walk(node, depth)
		if depth > 6 then return end
		for _, obj in ipairs(node:GetChildren()) do
			if not seen[obj] then
				seen[obj] = true
				if obj:IsA("BasePart") then
					local match = has_any(obj.Name, patterns)
					if only_prompt then
						local prompt = obj:FindFirstChildOfClass("ProximityPrompt")
						if prompt and has_any(prompt.ActionText, CONFIG.steal_action_keys) then
							match = true
						end
					end
					if match then table.insert(out, obj) end
				else
					walk(obj, depth + 1)
				end
			end
		end
	end
	walk(workspace, 0)
	return out
end

local function find_eggs() return scan_parts(CONFIG.egg_name_patterns, true) end

local function find_base()
	local team  = player.Team
	local bases = scan_parts(CONFIG.base_name_patterns, false)
	if team then
		for _, b in ipairs(bases) do
			if b.BrickColor == team.TeamColor then return b end
		end
	end
	return bases[1]
end

local function carrying_egg()
	local ch = player.Character
	if ch then
		for _, d in ipairs(ch:GetDescendants()) do
			if (d:IsA("BasePart") or d:IsA("Tool"))
				and has_any(d.Name, CONFIG.egg_name_patterns) then
				return true
			end
		end
	end
	local hum = get_hum()
	if hum and hum.WalkSpeed < CONFIG.default_speed - 2 then return true end
	return false
end

local function set_status(text)
	if ui.status then ui.status.Text = text end
end

-- ================= ESTADO =================
local state = {
	speed_carry = false,
	auto_return = false,
	auto_grab   = false,
	auto_farm   = false,
	anti_stun   = false,
	radar       = false,
	quick_step  = false,
	shuffle     = false,
}

local stats = { grabs = 0, returns = 0 }
local last_grab = 0

-- ================= AÇÕES =================
local function grab_nearest_egg()
	local hrp = get_root()
	if not hrp then return end
	local eggs = find_eggs()
	local best, best_d
	for _, e in ipairs(eggs) do
		if e:IsDescendantOf(workspace) then
			local d = (hrp.Position - e.Position).Magnitude
			if not best_d or d < best_d then best, best_d = e, d end
		end
	end
	if not best then return end
	local prompt = best:FindFirstChildOfClass("ProximityPrompt")
	if prompt and fireproximityprompt then
		pcall(fireproximityprompt, prompt)
		stats.grabs = stats.grabs + 1
		last_grab = os.clock()
	end
end

local function tp_nearest_egg()
	local hrp = get_root()
	if not hrp then return end
	local eggs = find_eggs()
	local best, best_d
	for _, e in ipairs(eggs) do
		if e:IsDescendantOf(workspace) then
			local d = (hrp.Position - e.Position).Magnitude
			if not best_d or d < best_d then best, best_d = e, d end
		end
	end
	if best then hrp.CFrame = best.CFrame + Vector3.new(0, 4, 0) end
end

local function tp_to_base()
	local hrp  = get_root()
	local base = find_base()
	if hrp and base then
		hrp.CFrame = base.CFrame + Vector3.new(0, 4, 0)
	end
end

local function deposit_at_base()
	local hrp  = get_root()
	local base = find_base()
	if not hrp or not base then return false end
	if (hrp.Position - base.Position).Magnitude > 22 then return false end
	local fired = false
	for _, d in ipairs(base:GetDescendants()) do
		if d:IsA("ProximityPrompt") then
			pcall(fireproximityprompt, d)
			fired = true
		end
	end
	return fired
end

local function drop_current_egg()
	local ch  = player.Character
	if not ch then return false end
	local hum = ch:FindFirstChildOfClass("Humanoid")
	local hrp = ch:FindFirstChild("HumanoidRootPart")

	if player.PlayerGui then
		for _, pg in ipairs(player.PlayerGui:GetDescendants()) do
			if pg:IsA("TextButton") or pg:IsA("ImageButton") then
				local label = (pg:IsA("TextButton") and pg.Text) or pg.Name or ""
				if has_any(label, CONFIG.drop_action_keys) then
					pcall(function()
						if getconnections then
							for _, conn in ipairs(getconnections(pg.MouseButton1Click)) do
								conn:Fire()
							end
						end
					end)
					return true
				end
			end
		end
	end

	if hrp then
		for _, d in ipairs(workspace:GetDescendants()) do
			if d:IsA("ProximityPrompt")
				and has_any(d.ActionText, CONFIG.drop_action_keys) then
				local p = d.Parent
				if p and p:IsA("BasePart")
					and (hrp.Position - p.Position).Magnitude < 20 then
					pcall(fireproximityprompt, d)
					return true
				end
			end
		end
	end

	if hrp then
		local base = find_base()
		local dir  = base and (hrp.Position - base.Position).Unit
			or Vector3.new(1, 0, 1)
		hrp.CFrame = hrp.CFrame + dir * 220 + Vector3.new(0, 40, 0)
		task.wait(0.3)
	end
	if hum then hum:UnequipTools() end
	return false
end

local function steal_part(part)
	if not part or not part:IsDescendantOf(workspace) then return false end
	local hrp = get_root()
	if not hrp then return false end
	hrp.CFrame = part.CFrame + Vector3.new(0, 4, 0)
	task.wait(0.1)
	local prompt = part:FindFirstChildOfClass("ProximityPrompt")
	if prompt and fireproximityprompt then
		pcall(fireproximityprompt, prompt)
		stats.grabs = stats.grabs + 1
		set_status("roubado: " .. part.Name)
		return true
	end
	return false
end

local function nearest_egg(skip_base)
	local hrp = get_root()
	if not hrp then return nil end
	local base = skip_base and find_base() or nil
	local eggs = find_eggs()
	local best, best_d
	for _, e in ipairs(eggs) do
		if e:IsDescendantOf(workspace) then
			if not base or (e.Position - base.Position).Magnitude >= 40 then
				local d = (hrp.Position - e.Position).Magnitude
				if not best_d or d < best_d then best, best_d = e, d end
			end
		end
	end
	return best
end

local function auto_farm_tick()
	if carrying_egg() then
		tp_to_base()
		task.wait(0.25)
		deposit_at_base()
		stats.returns = stats.returns + 1
	else
		local hrp = get_root()
		if not hrp then return end
		local best = nearest_egg(false)
		if best then
			hrp.CFrame = best.CFrame + Vector3.new(0, 4, 0)
			task.wait(0.15)
			local prompt = best:FindFirstChildOfClass("ProximityPrompt")
			if prompt and fireproximityprompt then
				pcall(fireproximityprompt, prompt)
				stats.grabs = stats.grabs + 1
			end
		end
	end
end

-- ================= LOOPS =================
RunService.Heartbeat:Connect(function()
	local hum = get_hum()
	if not hum then return end

	if state.speed_carry then
		if carrying_egg() then
			if hum.WalkSpeed < CONFIG.carry_speed then
				hum.WalkSpeed = CONFIG.carry_speed
			end
		elseif hum.WalkSpeed ~= CONFIG.default_speed then
			hum.WalkSpeed = CONFIG.default_speed
		end
	end

	if state.anti_stun then
		local s = hum:GetState()
		if s == Enum.HumanoidStateType.FallingDown
			or s == Enum.HumanoidStateType.PlatformStanding
			or s == Enum.HumanoidStateType.Ragdoll then
			hum:ChangeState(Enum.HumanoidStateType.GettingUp)
		end
	end
end)

task.spawn(function()
	while task.wait(CONFIG.auto_grab_interval) do
		if state.auto_grab and os.clock() - last_grab > 0.2 then
			pcall(grab_nearest_egg)
		end
	end
end)

task.spawn(function()
	while task.wait(CONFIG.auto_return_interval) do
		if state.auto_return and carrying_egg() then
			pcall(function()
				tp_to_base()
				task.wait(0.25)
				deposit_at_base()
				stats.returns = stats.returns + 1
			end)
		end
	end
end)

task.spawn(function()
	while task.wait(CONFIG.auto_farm_interval) do
		if state.auto_farm then pcall(auto_farm_tick) end
	end
end)

task.spawn(function()
	while task.wait(CONFIG.quick_step_interval) do
		if state.quick_step then
			local egg = nearest_egg(true)
			if egg then pcall(steal_part, egg) end
		end
	end
end)

task.spawn(function()
	while task.wait(CONFIG.shuffle_interval) do
		if state.shuffle and carrying_egg() then
			local hrp = get_root()
			if hrp then
				local base = find_base()
				local away = base and (hrp.Position - base.Position)
					or Vector3.new(1, 0, 1)
				away = Vector3.new(away.X, 0, away.Z)
				if away.Magnitude < 1 then away = Vector3.new(1, 0, 1) end
				local jump = away.Unit * math.random(120, 260)
					+ Vector3.new(math.random(-60, 60), 0, math.random(-60, 60))
				hrp.CFrame = hrp.CFrame + jump + Vector3.new(0, 30, 0)
				task.wait(0.3)
				pcall(drop_current_egg)
				task.wait(0.4)
				local e = nearest_egg(true)
				if e and (hrp.Position - e.Position).Magnitude < 60 then
					local p = e:FindFirstChildOfClass("ProximityPrompt")
					if p and fireproximityprompt then
						pcall(fireproximityprompt, p)
						stats.grabs = stats.grabs + 1
					end
				end
			end
		end
	end
end)

task.spawn(function()
	while task.wait(0.3) do
		if state.radar then
			local hrp = get_root()
			if hrp then
				for _, p in ipairs(Players:GetPlayers()) do
					if p ~= player and p.Character then
						local t = p.Character:FindFirstChild("HumanoidRootPart")
						if t then
							local d  = (hrp.Position - t.Position).Magnitude
							local bb = t:FindFirstChild("MacaRadar")
							if d <= CONFIG.radar_range then
								if not bb then
									bb = Instance.new("BillboardGui")
									bb.Name = "MacaRadar"
									bb.Size = UDim2.fromOffset(90, 26)
									bb.AlwaysOnTop = true
									bb.StudsOffset = Vector3.new(0, 3, 0)
									local l = Instance.new("TextLabel")
									l.Name = "Lbl"
									l.Size = UDim2.fromScale(1, 1)
									l.BackgroundTransparency = 1
									l.TextScaled = true
									l.Font = Enum.Font.GothamBold
									l.TextColor3 = Color3.fromRGB(255, 80, 80)
									l.Parent = bb

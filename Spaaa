local function mini_btn(parent, label, bg, fg)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(0, 86, 1, 0)
	b.BackgroundColor3 = bg
	b.Text = label
	b.TextColor3 = fg
	b.TextSize = 11
	b.Font = Enum.Font.GothamBold
	b.AutoButtonColor = false
	b.BorderSizePixel = 0
	b.Parent = parent
	Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
	local s = Instance.new("UIStroke", b)
	s.Color = Color3.fromRGB(55, 55, 55); s.Thickness = 1
	return b, s
end

local function refresh_egg_list()
	for _, c in ipairs(scroll:GetChildren()) do
		if c:IsA("Frame") then c:Destroy() end
	end
	local hrp = get_root()
	if not hrp then return end
	local eggs = find_eggs()
	table.sort(eggs, function(a, b)
		return (hrp.Position - a.Position).Magnitude
			< (hrp.Position - b.Position).Magnitude
	end)
	for i, egg in ipairs(eggs) do
		if i > 60 then break end
		local dist = (hrp.Position - egg.Position).Magnitude
		local row = Instance.new("Frame")
		row.Size = UDim2.new(1, -4, 0, 28)
		row.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
		row.BorderSizePixel = 0
		row.Parent = scroll
		Instance.new("UICorner", row).CornerRadius = UDim.new(0, 6)
		local lbl = Instance.new("TextLabel")
		lbl.Size = UDim2.new(1, -70, 1, 0)
		lbl.Position = UDim2.fromOffset(8, 0)
		lbl.BackgroundTransparency = 1
		lbl.Text = string.format("%s · %dm", egg.Name, math.floor(dist))
		lbl.TextColor3 = Color3.fromRGB(220, 220, 220)
		lbl.TextSize = 11
		lbl.Font = Enum.Font.Gotham
		lbl.TextXAlignment = Enum.TextXAlignment.Left
		lbl.Parent = row
		local st = Instance.new("TextButton")
		st.Size = UDim2.fromOffset(56, 22)
		st.Position = UDim2.new(1, -62, 0.5, -11)
		st.BackgroundColor3 = Color3.fromRGB(25, 45, 30)
		st.Text = "Steal"
		st.TextColor3 = Color3.fromRGB(120, 240, 140)
		st.TextSize = 11
		st.Font = Enum.Font.GothamBold
		st.AutoButtonColor = false
		st.BorderSizePixel = 0
		st.Parent = row
		Instance.new("UICorner", st).CornerRadius = UDim.new(0, 4)
		local stk = Instance.new("UIStroke", st)
		stk.Color = Color3.fromRGB(90, 220, 120); stk.Thickness = 1
		st.MouseButton1Click:Connect(function() steal_part(egg) end)
	end
	scroll.CanvasSize = UDim2.new(0, 0, 0, sl.AbsoluteContentSize.Y + 4)
end

local btn_refresh = mini_btn(ctrl, "↻ Refresh",
	Color3.fromRGB(18, 18, 18), Color3.fromRGB(220, 220, 220))
btn_refresh.MouseButton1Click:Connect(refresh_egg_list)

local qs_btn, qs_stroke = mini_btn(ctrl, "Quick Step",
	Color3.fromRGB(18, 18, 18), Color3.fromRGB(230, 230, 230))
local function render_qs()
	qs_btn.Text = "Quick Step: " .. (state.quick_step and "ON" or "OFF")
	qs_btn.BackgroundColor3 = state.quick_step
		and Color3.fromRGB(25, 45, 30) or Color3.fromRGB(18, 18, 18)
	qs_stroke.Color = state.quick_step
		and Color3.fromRGB(90, 220, 120) or Color3.fromRGB(55, 55, 55)
end
render_qs()
qs_btn.MouseButton1Click:Connect(function()
	state.quick_step = not state.quick_step
	render_qs()
end)

local sh_btn, sh_stroke = mini_btn(ctrl, "Shuffle",
	Color3.fromRGB(18, 18, 18), Color3.fromRGB(230, 230, 230))
local function render_sh()
	sh_btn.Text = "Shuffle: " .. (state.shuffle and "ON" or "OFF")
	sh_btn.BackgroundColor3 = state.shuffle
		and Color3.fromRGB(45, 30, 30) or Color3.fromRGB(18, 18, 18)
	sh_stroke.Color = state.shuffle

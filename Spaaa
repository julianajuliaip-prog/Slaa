local toggle_renders = {}

local function make_toggle(parent, label, key)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1, 0, 0, 34)
	b.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
	b.TextColor3 = Color3.fromRGB(230, 230, 230)
	b.TextSize = 12
	b.Font = Enum.Font.GothamMedium
	b.AutoButtonColor = false
	b.BorderSizePixel = 0
	b.Parent = parent
	Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)
	local s = Instance.new("UIStroke", b)
	s.Color = Color3.fromRGB(45, 45, 45)
	s.Thickness = 1
	local function render()
		local on = state[key]
		b.Text = label .. ": " .. (on and "ON" or "OFF")
		b.BackgroundColor3 = on and Color3.fromRGB(25, 45, 30)
			or Color3.fromRGB(18, 18, 18)
		s.Color = on and Color3.fromRGB(90, 220, 120)
			or Color3.fromRGB(45, 45, 45)
	end
	render()
	table.insert(toggle_renders, render)
	b.MouseButton1Click:Connect(function()
		state[key] = not state[key]
		render()
	end)
	return b
end

local function make_action(parent, label, cb)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1, 0, 0, 34)
	b.BackgroundColor3 = Color3.fromRGB(22, 22, 28)
	b.Text = label
	b.TextColor3 = Color3.fromRGB(220, 220, 255)
	b.TextSize = 12
	b.Font = Enum.Font.GothamMedium
	b.AutoButtonColor = false
	b.BorderSizePixel = 0
	b.Parent = parent
	Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)
	local s = Instance.new("UIStroke", b)
	s.Color = Color3.fromRGB(60, 60, 100)
	s.Thickness = 1
	b.MouseButton1Click:Connect(function()
		pcall(cb)
		set_status(label .. " — disparado")
	end)
	return b
end

